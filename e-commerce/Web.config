<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<!-- La cadena de conexión (con la contraseña) vive en claves.config, que está en .gitignore y NO se sube al repo -->
	<connectionStrings configSource="claves.config" />
	<system.web>
		<compilation debug="false" targetFramework="4.8" />
		<!-- enableVersionHeader="false": no mandar el encabezado X-AspNet-Version (no anunciar la versión de .NET) -->
		<httpRuntime targetFramework="4.8" enableVersionHeader="false" />
		<customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
		<!-- Cultura fija en español de Argentina: los precios se ven "$ 80.000,00" en cualquier servidor
		     (Somee está en inglés y mostraba "$ 80,000.00"). Leer un precio escrito por el usuario NO depende
		     de esto: TryParsePrecio y la carga en ArticuloForm usan InvariantCulture. -->
		<globalization culture="es-AR" uiCulture="es-AR" />
		<!-- HttpOnly: el JavaScript de la página no puede leer las cookies (ej: la de sesión), así un XSS no puede robarla.
		     requireSSL (que viajen solo por https) se agrega en Web.Release.config, solo para producción. -->
		<httpCookies httpOnlyCookies="true" />
	</system.web>
	<!-- Encabezados de seguridad básicos: los agrega IIS a TODAS las respuestas (páginas, css, imágenes).
	     Van acá (y no en Web.Release.config) porque no cambian nada del funcionamiento local.
	     Quedan afuera a propósito:
	     - HSTS (Strict-Transport-Security): el certificado de Somee se renueva a mano cada 3 meses; si alguna vez
	       vence, HSTS haría que los navegadores no dejen entrar al sitio ni por http.
	     - Content-Security-Policy: el sitio usa scripts y estilos dentro del HTML y CDN; necesita una tarea aparte. -->
	<system.webServer>
		<httpProtocol>
			<customHeaders>
				<!-- no mandar "X-Powered-By: ASP.NET" (no anunciar la tecnología del servidor) -->
				<remove name="X-Powered-By" />
				<!-- el navegador respeta el tipo de archivo que dice el servidor y no lo "adivina":
				     evita que un archivo subido (ej: una imagen) se interprete como script -->
				<add name="X-Content-Type-Options" value="nosniff" />
				<!-- solo este mismo sitio puede mostrar la tienda dentro de un iframe (evita el clickjacking) -->
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<!-- al ir a otro sitio se manda solo el dominio, no la URL completa (con ?id=...) -->
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
		</compilers>
	</system.codedom>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.DependencyInjection.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
