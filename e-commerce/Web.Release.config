<?xml version="1.0" encoding="utf-8"?>

<!-- Para obtener más información sobre cómo usar la transformación de web.config, visite https://go.microsoft.com/fwlink/?LinkId=125889 -->

<!--
  Transformación que se aplica SOLO al publicar en Release (el sitio de Somee).
  Con F5 en Visual Studio se usa el Web.config tal cual, así que nada de esto afecta al desarrollo local.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- requireSSL: la cookie de sesión solo viaja por https (en http el navegador no la manda).
         Se suma al httpOnlyCookies="true" que ya está en Web.config. -->
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
  </system.web>

  <!-- Redirección permanente (301) de http a https con el módulo URL Rewrite de IIS.
       InsertIfMissing: crea cada sección solo si Web.config todavía no la tiene. La regla también usa
       InsertIfMissing (buscándola por nombre): con "Insert" quedaba DUPLICADA, porque al crear
       <system.webServer> ya se copia todo lo de adentro y después el Insert la agregaba otra vez. -->
  <system.webServer xdt:Transform="InsertIfMissing">
    <rewrite xdt:Transform="InsertIfMissing">
      <rules xdt:Transform="InsertIfMissing">
        <rule name="Redirigir http a https" stopProcessing="true" xdt:Transform="InsertIfMissing" xdt:Locator="Match(name)">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <!-- la request llegó por http... -->
            <add input="{HTTPS}" pattern="^OFF$" />
            <!-- ...y no pasó antes por un proxy que ya atendió el https (si no, quedaría en un bucle de redirecciones) -->
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
            <!-- ...y no es la PC local (por si alguna vez se publica en Release a un IIS local) -->
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
          </conditions>
          <!-- 301 (Permanent): el navegador y los buscadores recuerdan que la dirección correcta es la https.
               {R:1} es la ruta pedida; el query string (?id=...) se agrega solo. -->
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
