<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="e_commerce.MasterPage" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%-- el título se arma en MasterPage.Master.cs (Page_PreRender) con el Title de cada página --%>
    <title></title>

    <%-- favicon (ícono de la pestaña): el .svg se ve nítido en navegadores modernos; el .ico (16/32/48 px) es
         para los que no soportan SVG. sizes="32x32" en el .ico hace que los navegadores que entienden SVG lo prefieran --%>
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/Images/favicon.svg" type="image/svg+xml" />
    
    <%-- boostrap css --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <%-- estilos propios: van DESPUÉS de Bootstrap para poder completar o pisar sus reglas --%>
    <link href="~/Content/estilos.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">
        
        <%-- navbar de boostrap --%>
        <%-- navbar-marca (estilos.css): fondo oscuro de la paleta. Todos los botones de navegación van en
             outline-light; el único con color es "Registrarse" (acento), la llamada a la acción para visitantes --%>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-marca">
          <div class="container">
            <a class="navbar-brand" href="Default.aspx">🛒 <%: NombreTienda %></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
              <ul class="navbar-nav me-auto">
                <li class="nav-item">
                  <a class="nav-link active" href="Default.aspx">Catálogo</a>
                </li>
              </ul>
              
             <%-- btn dinámicos --%>
              <div class="d-flex align-items-center">
                  
                 
                  <% if (!Negocio.Seguridad.sesionActiva(Session["usuario"])) { %>
                      
                      <a href="Login.aspx" class="btn btn-outline-light me-2">Iniciar Sesión</a>
                      
                  
                      <a href="Registro.aspx" class="btn btn-acento fw-bold">Registrarse</a>
                  
                  <% } else { %>
                      
                     
                      <% if (Negocio.Seguridad.esAdmin(Session["usuario"])) { %>
                          <a href="ArticulosLista.aspx" class="btn btn-outline-light me-3 fw-bold">⚙ Administrar Catálogo</a>
                      <% } %>
                      
                      <%-- zona del usuario logueado (avatar, nombre, Mi Perfil y salir) --%>
                      <asp:Image ID="imgAvatar" runat="server" CssClass="me-2 rounded-circle border border-2 border-secondary" Style="height: 40px; width: 40px; object-fit: cover;" />
                      <asp:Label ID="lblUser" runat="server" CssClass="text-light me-3 fw-bold"></asp:Label>
                      
                      <%-- btn miPerfil --%>
                      <a href="MiPerfil.aspx" class="btn btn-sm btn-outline-light me-3">👤 Mi Perfil</a>
                      <a href="Favoritos.aspx" class="btn btn-sm btn-outline-light me-3">♥ Favoritos</a>

                      <%-- Salir no es una acción destructiva (no borra datos): va en outline-light como el resto --%>
                      <asp:Button Text="Salir" ID="btnSalir" CssClass="btn btn-sm btn-outline-light" OnClick="btnSalir_Click" runat="server" />
                  
                  <% } %>
              </div>

            </div> </div> </nav> <%-- contenedor ppal de las otras páginas (mb-5: separa cualquier página del footer) --%>
        <div class="container mt-4 mb-5 flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <%-- footer  --%>
        <footer class="footer-marca text-center py-3 mt-auto">
            <div class="container">
                <p class="mb-0">&copy; <%: DateTime.Now.Year %> - <%: NombreTienda %>. Todos los derechos reservados.</p>
            </div>
        </footer>

    </form>

    <%-- boostrap js --%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>